{
  "name": "vibeshell-vscode",
  "displayName": "VibeShell",
  "description": "VibeShell — AI coding agents inside your editor. Type `vibeshell` in the terminal to open it.",
  "version": "0.1.1",
  "publisher": "vibeshell",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "AI"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onUri",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vibeshell.open",
        "title": "VibeShell: Open panel"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "vibeshellPanel",
          "title": "VibeShell",
          "icon": "media/panel-icon.svg"
        }
      ]
    },
    "views": {
      "vibeshellPanel": [
        {
          "id": "vibeshell.view",
          "type": "webview",
          "name": "VibeShell"
        }
      ]
    }
  },
  "scripts": {
    "bundle": "node scripts/bundle.js",
    "package": "node scripts/bundle.js && vsce package --allow-missing-repository --skip-license"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.199",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.5"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.0"
  }
}
